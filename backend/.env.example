# ─────────────────────────────────────────────────────────────
#  Estepink Backend — ortam değişkenleri
#  Bu dosyayı ".env" olarak kopyalayıp kendi bilgilerinizi girin.
# ─────────────────────────────────────────────────────────────

PORT=3001

# Frontend adres(ler)i — virgülle ayırarak birden fazla girilebilir
CORS_ORIGIN=http://localhost:5173

# ► Form mesajlarının GELECEĞİ e-posta adresi (BURAYI DEĞİŞTİRİN)
MAIL_TO=info@estepink-ornek.com

# ► Gönderen olarak görünecek ad / adres
MAIL_FROM="Estepink Web Sitesi <no-reply@estepink-ornek.com>"

# ► SMTP bilgileri
#   Gmail için: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true
#   SMTP_PASS alanına normal şifre DEĞİL, Google "Uygulama Şifresi" girilir.
#   Bu alanlar boş bırakılırsa sunucu "geliştirme modu"nda çalışır:
#   e-posta gönderilmez, mesaj terminale yazdırılır.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
